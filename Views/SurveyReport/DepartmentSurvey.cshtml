@model PollingApplication.ViewModels.SurveyResults;
@{

    ViewData["Title"] = "SurveyReport";

    var averageScores = Model.EmployeeQuestionAverages.ToList();

    var alldepartments = Model.Departments
        .Select(e => e.DepartmentName)
        .Distinct()
        .ToList();
   
}


<div class="row mb-4">
    <div class="col-md-12 d-flex">
        <div class="card shadow-sm rounded flex-grow-1">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">

                    @foreach (var departmentName in alldepartments)
                    {
                        var tabId = departmentName.Replace(" ", "-").ToLower() + "-tab";
                        var paneId = departmentName.Replace(" ", "-").ToLower() + "-pane";

                        <li class="nav-item">
                            <a class="nav-link @(departmentName == alldepartments.First() ? "active" : "")" id="@tabId" data-bs-toggle="tab" href="#@paneId" role="tab"
                               aria-controls="@paneId" aria-selected="@(departmentName == alldepartments.First() ? "true" : "false")">
                                @departmentName
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="card-body">
                
                <div class="tab-content" id="tabContent">

                    @foreach (var departmentName in alldepartments)
                    {
                        var paneId = departmentName.Replace(" ", "-").ToLower() + "-pane";

                        <div class="tab-pane fade @(departmentName == alldepartments.First() ? "show active" : "")"
                             id="@paneId" role="tabpanel" aria-labelledby="@(paneId)-tab">

                            <div class="mb-4 overflow-auto" style="max-height: 300px;">
                                <h5 class="card-title">Average Scores for @departmentName</h5>

                                <table class="table sortable-table">
                                    <caption>Table shows average scores for @departmentName department</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Employee Id</th>
                                            <th scope="col">Employee</th>
                                            <th scope="col">Department Name</th>
                                            <th scope="col">Question</th>
                                            <th scope="col">Average Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var result in averageScores.Where(r => r.DepartmentName == departmentName))
                                        {
                                            <tr>
                                                <td>@result.EmployeeId</td>
                                                <td>@result.EmployeeName</td>
                                                <td>@result.DepartmentName</td>
                                                <td>@result.QuestionText</td>
                                                <td>@result.AverageScore</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mb-4 overflow-auto" style="max-height: 300px;">
                                <h5 class="card-title">Department Sessions</h5>

                                <table class="table sortable-table">
                                    <caption>Shows if sessions are open or closed for @departmentName department</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Employee Id</th>
                                            <th scope="col">Employee</th>
                                            <th scope="col">Department</th>
                                            <th scope="col">Start Time</th>
                                            <th scope="col">End Time</th>
                                            <th scope="col">Completed</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var result in Model.EmployeeDepartmentSurveyResults.Where(r => r.DepartmentName == departmentName))
                                        {
                                            <tr>
                                                <td>@result.EmployeeId</td>
                                                <td>@result.EmployeeName</td>
                                                <td>@result.DepartmentName</td>
                                                <td>@result.StartTime</td>
                                                <td>@result.EndTime</td>
                                                <td>@result.IsCompleted</td>
                                                <td>
                                                    <form asp-controller="SurveyReport" asp-action="DeleteSession" method="post"
                                                          asp-route-id="@result.SessionId" onsubmit="return confirm('Are you sure you want to delete this session for @result.EmployeeName?');">

                                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="overflow-auto" style="max-height: 300px;">

                                <h5 class="card-title">Employee Comments for @departmentName</h5>
                                <table class="table sortable-table">
                                    <caption>Table shows additional comments from employees in @departmentName department</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Employee Id</th>
                                            <th scope="col">Employee</th>
                                            <th scope="col">Department</th>
                                            <th scope="col">Comments</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var result in Model.SurveyComments.Where(c => c.Employee.Department.DepartmentName == departmentName))
                                        {
                                            <tr>
                                                <td>@result.EmployeeId</td>
                                                <td>@result.Employee.FirstName @result.Employee.LastName</td>
                                                <td>@result.Employee.Department.DepartmentName</td>
                                                <td>@result.Comment</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>


                        </div>


                    }
                </div>
            </div>
        </div>
    </div>
</div>



