@using PollingApplication.Models;
@model PollingApplication.ViewModels.SurveyerModel;

@{
    ViewData["Title"] = "Survey Results";

    var generalDep = Model.genQuestions.FirstOrDefault();
    var specificDep = Model.deptQuestions.FirstOrDefault();
}

<form asp-controller="Home" asp-action="SubmitSurvey" method="post">
    
    <input type="hidden" name="SurveyGuid" value="@Model.SurveyGuid" />
    
    <div class="row  mb-4">
        <div class="card shadow-sm">
        
            <div class="card-header">
                <h3 class="card-title">@generalDep?.Department?.DepartmentName</h3>
            </div>

                    @foreach (var question in Model.genQuestions)
                    {
                        <div class="row align-items-center mb-3 g-3">
                            <div class="col-md-6">
                                <h5 class="mb-0">@question.Questions</h5>
                            </div>

                        <div class="col-md-6">
                                <div class="scale-options" data-question-id="@question.Id">

                                    @foreach (var item in Model.ScaleValues)
                                    {
                                        <div class="form-check d-inline-flex flex-column align-items-center me-3">
                                            <label>@item.Text</label>
                                            <input type="radio" name="Q_@question.Id" value="@item.Value"/>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div> 
                    }
       
         </div> 
     </div>

    <div class="row mb-4">
        <div class="card shadow-sm">

            <div class="card-header">
                <h3 class="card-title">@specificDep?.Department?.DepartmentName</h3>
            </div>

                @foreach (var question in Model.deptQuestions)
                {
                    <div class="row align-items-center mb-3 g-3">

                        <div class="col-md-6">
                            <h5 class="me-3 mb-0">@question.Questions</h5>
                        </div>

                        <div class="col-md-6">
                            <div class="scale-options" data-question-id="@question.Id">

                                @foreach (var item in Model.ScaleValues)
                                {
                                    <div class="form-check d-inline-flex flex-column align-items-center me-3">
                                        <label>@item.Text</label>
                                        <input type="radio" name="Q_@question.Id" value="@item.Value"/>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
       

        </div>
    </div>

    <div class="row">
        <div class="card shadow-sm">
         
            <div class="card-header">
                <h3 class="card-title">Addition Comments</h3>
            </div>
            <div class="form-group">
                <textarea name="AdditionalComments" id="commentsText" class="form-control" rows="4"></textarea>
            </div>
        </div>
    </div>

    <button type="button" onclick="submitSurveyAjax()">Submit</button>
</form>

<script>
    function submitSurveyAjax() {
        var surveyGuid = '@Model.SurveyGuid';
        var employeeId = '@Model.EmployeeId';
        var responseList = [];
        
        document.querySelectorAll('.scale-options').forEach(function (optionDiv) {
            var questionId = optionDiv.getAttribute('data-question-id');
            var selectedOption = optionDiv.querySelector('input[type="radio"]:checked');
            if (selectedOption) {
                responseList.push({
                    QuestionId: questionId,
                    ScaleValue: selectedOption.value,
                    EmployeeId: employeeId
                });
            }
        });
        
        var additionalComments = document.getElementById('commentsText').value;

        var submissionData = {
            SurveyGuid: surveyGuid,
            surveyResponses: responseList,
            surveyComments: additionalComments
        };

        fetch('/Home/SubmitSurvey', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(submissionData)
        })
        .then(response => response.json())
        .then(data => {
            if(data.redirectUrl){
                window.location.href = data.redirectUrl;
            };
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while submitting the survey.');
        });
    }
</script>